{
  "name": "privacy-x-ray",
  "version": "0.1.0-desktop-test.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare:ocr && npm run typecheck && vite build && node scripts/prepare-deployment.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "postinstall": "node scripts/prepare-ocr.mjs",
    "test:headless-face": "playwright test --config playwright.headless.config.ts",
    "test:browser": "playwright test",
    "benchmark:ocr": "playwright test tests/v2-benchmark.spec.ts",
    "test:browser:production": "playwright test --config playwright.production.config.ts",
    "prepare:test-fixtures": "node scripts/prepare-test-fixtures.mjs",
    "test:integration": "playwright test tests/advanced-visual-review.spec.ts tests/v2-workflow.spec.ts tests/export.spec.ts tests/editor-integration.spec.ts tests/v2-qr.spec.ts tests/student-card-recognition.spec.ts tests/material-recognition.spec.ts tests/simple-workflow.spec.ts tests/expanded-recognition.spec.ts tests/face-precision.spec.ts tests/ocr-orientation.spec.ts tests/detail-ocr.spec.ts tests/address-recognition.spec.ts tests/card-layout-recognition.spec.ts --workers=2",
    "desktop:build": "npm run prepare:ocr && npm run typecheck && tsc --project desktop/tsconfig.json && vite build --outDir dist-desktop && npm --prefix desktop run stage",
    "desktop:test": "tsc --project desktop/tsconfig.json && npm --prefix desktop test",
    "desktop:start": "npm --prefix desktop run start",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:smoke": "node desktop/test/smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@tensorflow-models/face-detection": "1.0.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
